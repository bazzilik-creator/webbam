# mod_rewrite start here
RewriteEngine on
# does not applyto existing directories, meaning that if the folder exists on the server then don't change anything and don't run the rule !
RewriteCond %{REQUEST_FILENAME} !-d
# check for file in the directory with .html extention
RewriteCond %{REQUEST_FILENAME}\.html -f
# here we actually show the page that has the .html extension
RewriteRule ^(.*)$ $1.html [NC,L]

